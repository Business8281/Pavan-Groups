{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pavan-groups",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
